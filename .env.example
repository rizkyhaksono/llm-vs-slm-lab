# Salin file ini jadi .env, lalu isi dengan API key kamu sendiri.
#
#   cp .env.example .env
#
# .env sudah di-gitignore, jadi key-mu tidak akan ke-commit.
#
# CATATAN COLAB: di Google Colab kamu TIDAK pakai file ini.
# Set key lewat Colab Secrets (ikon kunci di sidebar) dengan nama yang
# sama (GROQ_API_KEY). Helper get_secret() di utils/llm_clients.py
# otomatis pilih sumber yang benar.

# Groq — gratis di https://console.groq.com (klik "API Keys")
# Dipakai sebagai LLM utama di repo ini.
GROQ_API_KEY=

# OpenRouter — opsional, fallback kalau Groq down / rate-limit.
# Daftar di https://openrouter.ai/keys
OPENROUTER_API_KEY=

# (Opsional) HuggingFace token — kalau kamu mau download model gated.
# Sebagian besar notebook tidak butuh token; hanya kalau pakai model
# yang butuh accept terms (mis. Llama-3 raw weights).
# HF_TOKEN=

# (Opsional) Mirror HuggingFace untuk ISP yang lambat/mblok hf.co
# HF_ENDPOINT=https://hf-mirror.com

# (Opsional) Speed-up download HF — install hf_transfer dulu kalau pakai
# HF_HUB_ENABLE_HF_TRANSFER=1
